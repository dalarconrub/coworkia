TODOIST_API_KEY=

NOTION_TOKEN=
NOTION_DS_PROYECTOS=
NOTION_DS_TAREAS=
NOTION_DS_NOTAS=
NOTION_DS_KIT_KNOWLEDGE=
NOTION_DS_KIT_INFORMATION=
NOTION_DS_KIT_TOOLS=
NOTION_DB_GIT=
NOTION_GIT_PARENT_PAGE=
NOTION_DB_BIB=
NOTION_BIB_PARENT_PAGE=

GITHUB_TOKEN=
# PAPERPILE_BIBTEX_URL: desde 2026 Paperpile retiro URLs paperpile.com/eb/...
# Usa raw.githubusercontent.com de un repo GitHub configurado como destino de
# "Automatic BibTeX Export" (ver docs/bib-agent.md). Si el repo es privado,
# GITHUB_TOKEN (scope repo) es obligatorio.
PAPERPILE_BIBTEX_URL=

OBSIDIAN_ALPHA_PATH=
OBSIDIAN_ABGD_ROOT=

# Inoreader (https://www.inoreader.com/developers/)
# - APP_ID y APP_KEY: emitidos al registrar la app (plataforma Desktop, scope read)
# - REDIRECT_URI: debe coincidir literalmente con el registrado en la app
# - FOLDER_KIT: nombre del folder O tag (en Inoreader son intercambiables a
#   nivel URL: ambos sirven /tag/<nombre>/) que se sincroniza a KIT.
#   Convencion del proyecto: usar TAG (no folder) para curacion selectiva
#   articulo a articulo. El sync NO importa los 'starred' porque en Inoreader
#   es el buffer de "Read later" y no implica intencion de catalogar.
# Los tokens (access/refresh) NO van aqui, viven en artifacts/inoreader_state.json
# tras correr `python tools/inoreader_oauth.py` (gitignored).
INOREADER_APP_ID=
INOREADER_APP_KEY=
INOREADER_REDIRECT_URI=http://localhost:8080/callback
INOREADER_FOLDER_KIT=kit-import

# Raindrop.io (https://developer.raindrop.io/)
# - ACCESS_TOKEN: Bearer token REST manual. Opcional si usas OAuth.
# - CLIENT_ID/SECRET/REDIRECT_URI: OAuth REST con `python tools/raindrop_oauth.py`.
# - TAG_KIT: tag explicito que marca bookmarks a catalogar en KIT.
# - COLLECTION_ID: 0 = todos excepto Trash; tambien puedes poner un ID concreto.
# - SEARCH_KIT: opcional; si lo defines, el filtro se delega al buscador de
#   Raindrop (ej. #kit-import). Si queda vacio, Coworkia filtra client-side por tag.
# - MCP endpoint para clientes IA Pro: https://api.raindrop.io/rest/v2/ai/mcp
RAINDROP_ACCESS_TOKEN=
RAINDROP_CLIENT_ID=
RAINDROP_CLIENT_SECRET=
RAINDROP_REDIRECT_URI=http://localhost:8766/callback
RAINDROP_TAG_KIT=kit-import
RAINDROP_COLLECTION_ID=0
RAINDROP_SEARCH_KIT=
